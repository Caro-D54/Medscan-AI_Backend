# ==============================================================================
# MedScan AI Backend - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo como '.env' en este mismo directorio y completa los valores.
# ADVERTENCIA: NUNCA subas el archivo '.env' con claves reales a control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL 18)
# ------------------------------------------------------------------------------
POSTGRES_DB=medscan_db
POSTGRES_PORT=5432
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_super_secure_password_123

# NOTA PARA DOCKER COMPOSE VS DESARROLLO LOCAL SIN DOCKER:
# - En Docker Compose: la API se conecta al contenedor 'postgres' por red interna:
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/medscan_db
# - Para ejecutar Spring Boot directamente en el host (mvnw spring-boot:run):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medscan_db

# ------------------------------------------------------------------------------
# 2. Servidor y Perfil de Entorno (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
# Perfil activo: 'dev' para desarrollo local relajado, 'prod' para producción estricta 12-factor
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 3. Seguridad y Autenticación JWT (JSON Web Tokens)
# ------------------------------------------------------------------------------
# La clave secreta debe tener un mínimo de 256 bits (32 caracteres alfanuméricos)
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_32_caracteres_aleatorios_12345
# Tiempo de expiración del token en milisegundos (86400000 ms = 24 horas)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Escaneo Inteligente con IA (OpenAI API - Vision / Chat)
# ------------------------------------------------------------------------------
# Tu API Key de OpenAI (ej. sk-proj-...)
SCAN_OPENAI_API_KEY=tu_openai_api_key_aqui
SCAN_OPENAI_MODEL=gpt-4o-mini
SCAN_OPENAI_URL=https://api.openai.com/v1/chat/completions
SCAN_OPENAI_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 5. Notificaciones Push (Expo Notifications) y Recordatorios
# ------------------------------------------------------------------------------
NOTIFICATION_EXPO_URL=https://exp.host/--/api/v2/push/send
# Intervalo de verificación del planificador de recordatorios (60000 ms = 1 minuto)
NOTIFICATION_REMINDER_DELAY_MS=60000
# Minutos de anticipación con los que se notifica la dosis programada (ej. 10 minutos)
NOTIFICATION_REMINDER_ADVANCE_MINUTES=10
